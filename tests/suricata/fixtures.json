    {
      "id": "lab_modbus_long_session",
      "note": "One Modbus connection: 1,153,440 bytes of FC1 polling, then an FC6 write from the non-writer. Suricata 8.0.7 stops reassembly at stream.reassembly.depth (1 MiB per direction) and app-layer.protocols.modbus.stream-depth does not lift it, so the write is NOT seen at default settings. This fixture documents that limit.",
      "path": "tests/suricata/lab/lab_modbus_long_session.pcap.gz",
      "sha256": "dd01ca63565b9395c6a0189508858ac18d6ca04590bb4245e20b024f96879257",
      "vars": "lab",
      "expect": "absent",
      "expect_sids": [
        9100001
      ]
    },
    {
      "id": "lab_modbus_long_session_depth_10mb",
      "note": "Same capture with the global depth raised above the session size: the write is seen.",
      "path": "tests/suricata/lab/lab_modbus_long_session.pcap.gz",
      "sha256": "dd01ca63565b9395c6a0189508858ac18d6ca04590bb4245e20b024f96879257",
      "vars": "lab",
      "sets": [
