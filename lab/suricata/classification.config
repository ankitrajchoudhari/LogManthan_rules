# Classtypes used by the LM-OT rules (lab sensor only).
# Format: config classification: <shortname>,<description>,<default priority>
# Every rule sets its own priority, which overrides the default here.
# The test lint fails if a rule uses a classtype that is not listed in this file.
config classification: attempted-recon,Attempted information gathering,2
config classification: attempted-dos,Attempted denial of service,2
config classification: policy-violation,Policy violation,1
config classification: protocol-command-decode,Unusual protocol command,3
